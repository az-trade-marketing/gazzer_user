{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "gazzer-ios",
            "request": "launch",
            "type": "dart",
        },
        {
            "name": "gazzer-st",
            "request": "launch",
            "type": "dart",
             "args": [
                "--flavor",
                "staging",
                "--target",
                "lib/main.dart"
            ]
        },
        {
            "name": "gazzer-prod",
            "request": "launch",
            "type": "dart",
             "args": [
                "--flavor",
                "production",
                "--target",
                "lib/main.dart"
            ]
        },
        {
            "name": "gazzer-user-app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "gazzer-user-app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}